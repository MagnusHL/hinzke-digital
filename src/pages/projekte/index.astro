---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTAButton from '../../components/CTAButton.astro';
import { getCollection } from 'astro:content';

const projekte = (await getCollection('projekt')).sort((a, b) => a.data.order - b.data.order);

const breadcrumbItems = [
  { label: 'Startseite', href: '/' },
  { label: 'Projekte' },
];

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Projekte aus dem Haus",
  "description": "Webseiten, Onlineshops und Bestellkanäle, die Hinzke Digital gebaut und im Betrieb hat.",
  "itemListElement": projekte.map((projekt, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": projekt.data.title,
    "url": `https://hinzke.digital/projekte/${projekt.id}/`,
  })),
};
---

<Layout
  title="Projekte"
  description="Referenzen von Hinzke Digital: Onlineshop hinzke.de, PlotService für Pläne und CAD und die Hygieneberatung Lübeck. Alle drei laufen live."
  canonicalUrl="https://hinzke.digital/projekte/"
  structuredData={itemListSchema}
>
  <section class="py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <Breadcrumb items={breadcrumbItems} />

      <div class="max-w-3xl">
        <h1 class="text-4xl font-bold text-gray-900 md:text-5xl">Projekte</h1>
        <p class="mt-6 text-lg leading-relaxed text-gray-600">
          Hinzke Digital betreibt drei eigene Projekte: den Onlineshop
          <a href="/projekte/hinzke-de/" class="font-medium text-primary hover:underline">hinzke.de</a> für die Druckerei,
          den <a href="/projekte/plot-hinzke-de/" class="font-medium text-primary hover:underline">PlotService</a> für Pläne und CAD
          und die <a href="/projekte/hygiene-luebeck-de/" class="font-medium text-primary hover:underline">Hygieneberatung Lübeck</a>.
          Alle drei sind live und im täglichen Einsatz. Sie zeigen, was hier gebaut wird: Shops, Bestellkanäle und
          Webseiten, die an Warenwirtschaft, Buchung und Bezahlung angebunden sind.
        </p>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {projekte.map((projekt) => (
          <article class="flex flex-col rounded-xl border border-gray-200 p-6 transition-all hover:border-primary/30 hover:shadow-lg">
            <p class="mb-2 text-sm font-medium uppercase tracking-wider text-gray-500">{projekt.data.branche}</p>
            <h2 class="mb-2 text-lg font-semibold text-gray-900">
              <a href={`/projekte/${projekt.id}/`} class="hover:text-primary">{projekt.data.title}</a>
            </h2>
            <p class="flex-1 text-sm leading-relaxed text-gray-600">{projekt.data.description}</p>
            <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
              <a href={`/projekte/${projekt.id}/`} class="inline-flex items-center text-sm font-medium text-primary hover:underline">
                Projekt ansehen
                <svg class="ml-1 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
              <a href={projekt.data.url} target="_blank" rel="noopener" class="text-sm text-gray-500 hover:text-primary hover:underline">
                Live ansehen
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-gray-50 py-16">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-gray-900">Ähnliches Projekt im Kopf?</h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-gray-600">
        Lass uns unverbindlich klären, was in deinem Fall sinnvoll ist.
      </p>
      <div class="mt-8">
        <CTAButton href="/kontakt" size="lg">Kontakt aufnehmen</CTAButton>
      </div>
    </div>
  </section>
</Layout>
