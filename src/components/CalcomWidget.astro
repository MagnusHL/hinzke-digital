---
// Buchungskarten mit Cal.com (self-hosted unter cal.hinzke.de).
// Die Buttons sind normale Links auf die Event-Seite und funktionieren ohne JS.
// Ist das Embed-Script geladen, öffnet sich Cal.com als Popup statt als neue Seite.

const CAL_ORIGIN = 'https://cal.hinzke.de';

interface CalEvent {
  title: string;
  duration: string;
  location: string;
  description: string;
  slug: string; // "<user>/<event-type>" in Cal.com
}

interface Props {
  events?: CalEvent[];
}

const defaultEvents: CalEvent[] = [
  {
    title: 'Erstgespräch Web & Digital',
    duration: '30 Min',
    location: 'per Video',
    description: 'Wir schauen gemeinsam, wo dein Unternehmen digital steht und was die nächsten sinnvollen Schritte sind.',
    slug: 'magnus/erstgespraech',
  },
  {
    title: 'Automatisierungs-Check',
    duration: '30 Min',
    location: 'per Video',
    description: 'Welche Abläufe in deinem Betrieb lassen sich automatisieren? Wir finden es raus.',
    slug: 'magnus/automatisierungs-check',
  },
];

const { events = defaultEvents } = Astro.props;
---

<div>
  <h3 class="mb-6 text-xl font-semibold text-gray-900">Beratungsgespräch buchen</h3>
  <div class="grid gap-4">
    {events.map((event) => (
      <div class="rounded-xl border border-gray-200 p-6 transition-shadow hover:shadow-md">
        <h4 class="text-lg font-semibold text-gray-900">{event.title}</h4>
        <p class="mt-1 text-sm text-gray-500">{event.duration} · {event.location}</p>
        <p class="mt-3 text-sm text-gray-600">{event.description}</p>
        <a
          href={`${CAL_ORIGIN}/${event.slug}`}
          data-cal-link={event.slug}
          data-cal-config='{"layout":"month_view","theme":"light"}'
          class="mt-4 inline-block rounded-lg bg-primary px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-blue-700"
        >
          Termin buchen
        </a>
      </div>
    ))}
  </div>
</div>

<script is:inline define:vars={{ CAL_ORIGIN }}>
  // Offizieller Cal.com Embed-Loader, auf die eigene Instanz gezeigt.
  (function (C, A, L) {
    var p = function (a, ar) { a.q.push(ar); };
    var d = C.document;
    C.Cal = C.Cal || function () {
      var cal = C.Cal;
      var ar = arguments;
      if (!cal.loaded) {
        cal.ns = {};
        cal.q = cal.q || [];
        d.head.appendChild(d.createElement('script')).src = A;
        cal.loaded = true;
      }
      if (ar[0] === L) {
        var api = function () { p(api, arguments); };
        var namespace = ar[1];
        api.q = api.q || [];
        if (typeof namespace === 'string') {
          cal.ns[namespace] = cal.ns[namespace] || api;
          p(cal.ns[namespace], ar);
          p(cal, ['initNamespace', namespace]);
        } else {
          p(cal, ar);
        }
        return;
      }
      p(cal, ar);
    };
  })(window, CAL_ORIGIN + '/embed/embed.js', 'init');
  Cal('init', { origin: CAL_ORIGIN });
  Cal('ui', { hideEventTypeDetails: false, layout: 'month_view' });
</script>
